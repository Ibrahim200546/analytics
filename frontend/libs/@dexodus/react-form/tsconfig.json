{
  "compilerOptions": {
    "target": "ES2021",
    "jsx": "react",
    "module": "CommonJS",
    "declaration": true,
    "sourceMap": true,
    "outDir": "src",
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.scss"
  ],
  "exclude": [
    "node_modules"
  ]
}
